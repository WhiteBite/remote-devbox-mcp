    {
      "title": {
        "ru": "Статусы стека и сервисов",
        "en": "Stack and service statuses"
      },
      "status": "beta"
    },
    {
      "title": {
        "ru": "Джобы, события и разрешения агента",
        "en": "Agent jobs, events and permissions"
      },
      "status": "beta"
    },
    {
      "title": {
        "ru": "Запуск/остановка стека и смена профиля",
        "en": "Stack up/down and profile switching"
      },
      "status": "beta"
    }
  ],
  "changelog": [
    {
      "version": "0.2.2",
      "date": "2026-10-09",
      "changes": [
        "profile_put fills empty git identity from host git config user.name/user.email before falling back to placeholders"
      ]
    },
    {
      "version": "0.2.1",
      "date": "2026-10-09",
      "changes": [
        "profile_put creates new profiles; profile_delete command added",
        "jobs_live and permissions_pending degrade to event journal on any bridge error"
      ]
    },
    {
      "version": "0.2.0",
      "date": "2026-10-09",
      "changes": [
        "Control plane moves to the Stitch core page: live vitals, job/permission control, profile editor, action payloads",
        "ui.kind flipped to core_page; declarative page nodes removed"
      ]
    },
    {
      "version": "0.1.3",
      "date": "2026-10-08",
      "changes": [
        "Adopt the real user home so profiles and devbox commands work under the plugin sandbox"
      ]
    },
    {
      "version": "0.1.2",
      "date": "2026-10-08",
      "changes": [
        "Add a Recent actions table so control buttons show their effect",
        "Render the active-profile flag as a human label"
      ]
    },
    {
      "version": "0.1.1",
      "date": "2026-10-01",
      "changes": [
        "Fix UI label i18n keys so the Devbox page resolves translations"
      ]
    },
    {
      "version": "0.1.0",
      "date": "2026-10-01",
      "changes": [
        "Initial release"
      ]
    }
  ],
