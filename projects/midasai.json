{
  "project_dir": "d:/Sources/StartUp/MidasAI",
  "toolchain": "",
  "git_name": "WhiteBite",
  "git_email": "ad.lord9000@yandex.ru",
  "preview_origin": "http://host.docker.internal:35204",
  "ui_port": 35205,
  "runner_commands": [
    {
      "name": "check:layers",
      "cmd": [
        "npm",
        "run",
        "check:layers"
      ],
      "description": "arch-layers gate (js+py)"
    },
    {
      "name": "check:parity",
      "cmd": [
        "npm",
        "run",
        "check:parity"
      ],
      "description": "bdd/parity baseline gate"
    },
    {
      "name": "check:rpc",
      "cmd": [
        "npm",
        "run",
        "check:rpc-sync"
      ],
      "description": "rpc sync gate"
    },
    {
      "name": "test:web",
      "cmd": [
        "npx",
        "vitest",
        "run"
      ],
      "args": {
        "file": {
          "type": "path",
          "position": "append"
        }
      },
      "description": "vitest workspace (опц. путь файла)"
    },
    {
      "name": "test:backend",
      "cmd": [
        "backend/.venv/Scripts/python.exe",
        "-m",
        "pytest",
        "-q"
      ],
      "args": {
        "path": {
          "type": "path",
          "position": "append"
        }
      },
      "description": "pytest backend (опц. путь)"
    },
    {
      "name": "dev:start",
      "cmd": [
        "powershell",
        "-NoProfile",
        "-File",
        "start-dev.ps1"
      ],
      "background": true,
      "port": 35204,
      "description": "backend+web dev-серверы (tree-kill только через dev:stop)"
    },
    {
      "name": "dev:stop",
      "cmd": [
        "powershell",
        "-NoProfile",
        "-File",
        "stop.ps1"
      ],
      "description": "остановка всех dev-серверов MidasAI"
    }
  ],
  "runner_port": 8796,
  "allowed_ports": [
    35203,
    35204,
    35205
  ],
  "deny_mounts": [
    "backend/.env",
    "ports.env",
    ".midas-bridge-token"
  ],
  "setup_cmds": []
}
