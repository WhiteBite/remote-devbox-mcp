# Скопируй в .env и заполни. .env в git не коммитить.
#
# Главная и обычно единственная переменная — PROJECT_DIR.
# Смена проекта = одна строка здесь + `docker compose up -d`.

# Папка проекта на твоём Windows-хосте.
# Формат Docker Desktop: прямые слеши, буква диска в нижнем регистре.
#   Java+Spring:  PROJECT_DIR=C:/Users/you/dev/backend
#   Flutter:      PROJECT_DIR=C:/Users/you/dev/app
PROJECT_DIR=C:/Users/you/dev/myproject

# Bearer-токен для MCP-эндпоинта. Мост требует минимум 24 символа.
# PowerShell: -join ((1..64) | % { '{0:x}' -f (Get-Random -Max 16) })
MCP_BEARER_TOKEN=replace-me-64-hex-chars

# Тулчейны проекта: entrypoint идемпотентно ставит их в /opt/tools (volume
# rdm-tools), кэш переживает смены проекта и пересоздания контейнера.
# Спеки через пробел: java21, flutter:<тег> (тег = пин проекта, см. .flutter-version).
TOOLCHAIN=

# Git-идентичность агента для коммитов внутри контейнера.
GIT_NAME=WhiteBite
GIT_EMAIL=you@example.com

# Порты host-сервисов со СВОЕЙ bearer-авторизацией (ingress пропускает токен
# транзитом). Заполняется devbox.ps1 use <имя> из профиля проекта.
SELF_AUTHED_PORTS=8787

# Имя активного профиля проекта (devbox.ps1 use <имя>).
ACTIVE_PROFILE=

# Куда смотрит preview-туннель: приложение в контейнере (http://toolbox:8788)
# или на хосте (http://host.docker.internal:8080 — напр. widgetbook через supervisor).
PREVIEW_ORIGIN=http://toolbox:8788

# Таймаут одной джобы в секундах. Допустимо 5–3600.
# gradle build / flutter test в первый раз долгие — не ставь меньше 1800.
JOB_TIMEOUT_SECONDS=1800

# Токен именованного Cloudflare-туннеля (пусто = быстрый trycloudflare).
TUNNEL_TOKEN=

# Bearer-токен host-сервисов профиля проекта (bearer-сервисы в projects/*.ps1;
# auth-proxy поднимает devbox.ps1 use <имя>).
# Сгенерировать: -join ((1..64) | % { '{0:x}' -f (Get-Random -Max 16) })
MCP_PUBLIC_TOKEN=replace-me-64-hex-chars

# Bearer-токен ingress-прокси (одна точка входа /p/<port>/* на все
# loopback-эндпоинты хоста; см. home/host/ingress-proxy.py).
INGRESS_TOKEN=replace-me-64-hex-chars

# VLESS-подписка для встроенного VPN (сервис vpn, sing-box в TUN-режиме).
# Туннели cloudflared идут через неё — DPI провайдера до края Cloudflare
# не достаёт. Пусто = прямой режим без VPN (годится, если твой провайдер
# не режет Cloudflare-туннели). URL подписки — секрет, не коммитить.
VLESS_SUB_URL=
