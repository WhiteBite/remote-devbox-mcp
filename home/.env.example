# Скопируй в .env и заполни. .env в git не коммитить.
#
# Главная и обычно единственная переменная — PROJECT_DIR.
# Смена проекта = одна строка здесь + `docker compose up -d`.

# Папка проекта на твоём Windows-хосте.
# Формат Docker Desktop: прямые слеши, буква диска в нижнем регистре.
#   Java+Spring:  PROJECT_DIR=C:/Users/you/dev/backend
#   Flutter:      PROJECT_DIR=C:/Users/you/dev/app
PROJECT_DIR=C:/Users/you/dev/myproject

# Bearer-токен для MCP-эндпоинта. Мост требует минимум 24 символа.
# PowerShell: -join ((1..64) | % { '{0:x}' -f (Get-Random -Max 16) })
MCP_BEARER_TOKEN=replace-me-64-hex-chars

# 1 — ставить в образ Flutter SDK (~4 ГБ, дольше сборка). 0 — только Java.
WITH_FLUTTER=1

# Таймаут одной джобы в секундах. Допустимо 5–3600.
# gradle build / flutter test в первый раз долгие — не ставь меньше 1800.
JOB_TIMEOUT_SECONDS=1800

# Токен именованного Cloudflare-туннеля (пусто = быстрый trycloudflare).
TUNNEL_TOKEN=
